{
  "name": "dailibi",
  "version": "0.1.0",
  "private": true,
  "description": "DAILIBI - Une affaire. Chaque jour.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:cloudflare": "vinext dev --port 3001",
    "build:cloudflare": "vinext build",
    "preview:cloudflare": "wrangler dev --config dist/server/wrangler.json",
    "deploy:cloudflare": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "case:new": "tsx scripts/new-case.ts",
    "case:generate": "tsx scripts/generate-case-collection.ts",
    "case:validate": "tsx scripts/validate-cases.ts",
    "case:cliche": "tsx scripts/cliche-check.ts"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "server-only": "0.0.1",
    "vinext": "^1.0.0-beta.9",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.9",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "autoprefixer": "10.4.20",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.13",
    "typescript": "5.9.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  },
  "type": "module"
}
